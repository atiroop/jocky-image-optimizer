{
  "name": "atiroop/jocky-image-optimizer",
  "description": "Self-hosted image optimization foundation for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "Jocky\\ImageOptimizer\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.3.0"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "test": "php tests/run.php",
    "test:encoders": "php tests/encoder-integration.php",
    "test:integration": "phpunit --configuration phpunit.xml.dist",
    "test:package": "php scripts/validate-package.php"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6.33",
    "squizlabs/php_codesniffer": "^3.13.6",
    "wp-coding-standards/wpcs": "^3.4.1",
    "yoast/phpunit-polyfills": "^1.1"
  }
}
